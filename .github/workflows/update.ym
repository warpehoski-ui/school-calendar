name: Update calendar

on:
  schedule:
    - cron: "0 13 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install icalendar recurring-ical-events tzdata
      - name: Download school calendar
        run: curl -fL -o basic.ics "https://calendar.google.com/calendar/ical/wnsk8.com_4gk29dm9gdovm9n2k4r6ulqi00%40group.calendar.google.com/public/basic.ics"
      - name: Filter calendar
        run: python filter_calendar.py
      - name: Save result
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add WNS_6th_8th_All_School.ics
          git diff --cached --quiet || git commit -m "Update calendar"
          git push
